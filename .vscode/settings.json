{
    "liveServer.settings.port": 5504,
    "git.ignoreLimitWarning": true,
    "python.analysis.ignore": ["dotenv"],
    "python.linting.pylintArgs": ["--generated-ignored=dotenv"],
    "latex-workshop.latex.recipe.default": "xelatex",
